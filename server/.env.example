PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# Only set this if the app runs behind a real reverse proxy (nginx, etc). Set it to the exact
# number of trusted hops in front of Node. Leave at 0 for local dev / direct connections -
# trusting an untrusted proxy count lets a client spoof req.ip via X-Forwarded-For, which
# would defeat both rate limiting and the network-authentication subnet check.
TRUST_PROXY_HOPS=0

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ssas

JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cost factor for password hashing. Used by the app AND the seed script, from one definition,
# so demo accounts can never end up weaker than accounts created through the app.
BCRYPT_ROUNDS=12

# Refresh-token rotation tolerates a replay this recent, to absorb the race between a page
# unloading and the next one booting. Longer than a few seconds weakens theft detection.
REFRESH_ROTATION_GRACE_MS=30000

# Dead refresh tokens are kept this long before purging, so a "why was I logged out" report
# can still be investigated.
REFRESH_TOKEN_RETENTION_DAYS=7

# Check-in attempt logs (including failures) are kept this long. Longer than tokens because a
# disputed absence can surface at the end of term.
ATTENDANCE_ATTEMPT_RETENTION_DAYS=180

# Fallback QR lifetime, in seconds, for sessions created before it was per-session and for
# any session that does not set its own. Teachers choose 10-300s per session.
QR_VALIDITY_WINDOW_SECONDS=30
DEFAULT_GEOFENCE_RADIUS_M=50

# The attendance floor students are measured against, shown on every dashboard.
MINIMUM_ATTENDANCE_PERCENT=75

# Institution-wide subnet for the login screen's "on campus" indicator only; the per-session
# authorised_subnet is what actually gates attendance. "any" means every network passes, which
# is why the login badge reads "Network check open" rather than showing a meaningless tick.
CAMPUS_SUBNET=any

# Loopback is NOT treated as on-campus unless this is true. It used to be unconditional, which
# silently disabled the third factor for anything reaching the server locally.
NETWORK_TRUST_LOOPBACK=false

# Public self-registration. Off by default: attendance is keyed to the institutional student
# number, so accounts are issued by an admin rather than signed up for. Set true for a demo.
ALLOW_PUBLIC_REGISTRATION=false
