# ---------------------------------------------------------------------------
# SSAS production environment
#
# Copy these into the host's environment-variable settings (Railway: service ->
# Variables). Do NOT commit a filled-in copy of this file.
#
# The app refuses to start in production if the values marked REQUIRED are
# missing or left at their development defaults - see assertProductionSecrets()
# in src/config/env.js. That check is deliberate: the dev secrets are published
# in this repository, and a JWT signing secret is all anyone needs to mint a
# valid admin token without a password.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=5000

# REQUIRED. Generate two DIFFERENT values, 32+ characters each:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# REQUIRED. Number of reverse proxies in front of the app. Railway and Render
# both put exactly one load balancer in front, so this is 1.
#
# This matters more here than in most apps: req.ip is what the network factor
# checks against the authorised subnet AND what the rate limiter buckets on.
# Too low and every student appears to come from the platform's proxy; too high
# and a client can spoof its own address by sending X-Forwarded-For.
TRUST_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Database - from the Railway MySQL service's "Connect" tab
# ---------------------------------------------------------------------------
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=railway

# Managed MySQL requires TLS.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Forward-only migrations run automatically before the port opens.
# db:init is NOT run automatically - it is a factory reset that drops every table.
RUN_MIGRATIONS_ON_START=true

# ---------------------------------------------------------------------------
# Attendance policy
# ---------------------------------------------------------------------------

# The public egress IP your campus presents to the internet - NOT an internal
# 192.168.x range. When the server runs off-campus, students' requests arrive
# from the campus NAT, so an internal range can never match. Find it by opening
# https://<your-app>/api/v1/auth/status while on campus Wi-Fi and reading
# clientIp. Use /32 for a single address, or the block your IT team gives you.
#   e.g. CAMPUS_SUBNET=203.0.113.45/32
# "any" disables the indicator and lets every network count as campus.
CAMPUS_SUBNET=any

# Keep sign-up closed: accounts are issued by the institution.
ALLOW_PUBLIC_REGISTRATION=false

QR_VALIDITY_WINDOW_SECONDS=30
DEFAULT_GEOFENCE_RADIUS_M=50
MINIMUM_ATTENDANCE_PERCENT=75
BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Backups (NFR10)
# ---------------------------------------------------------------------------
# The container filesystem is ephemeral on most platforms: without a mounted
# volume, backups are lost on every redeploy. Either attach a volume and point
# BACKUP_DIR at it, or set BACKUPS_ENABLED=false and rely on the database
# provider's own backups.
BACKUPS_ENABLED=true
# BACKUP_DIR=/data/backups
